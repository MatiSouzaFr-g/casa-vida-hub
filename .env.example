# ─── APP ────────────────────────────────────────────────
APP_PORT=3000
APP_ENV=development

# ─── MONGODB ATLAS (gratuito M0) ────────────────────────
# 1. Crear cuenta en https://www.mongodb.com/atlas
# 2. Crear cluster gratuito M0
# 3. Database Access → crear usuario
# 4. Network Access → agregar 0.0.0.0/0
# 5. Connect → Drivers → copiar URI
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/kingdom_hub?retryWrites=true&w=majority

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=minimo_32_caracteres_random_aqui_1234567890
JWT_EXPIRES_IN=30d

# ─── GMAIL SMTP ─────────────────────────────────────────
# Google Account → Security → 2-Step Verification → App Passwords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu@gmail.com
MAIL_PASS=xxxx_xxxx_xxxx_xxxx
MAIL_FROM="Kingdom Hub <noreply@kingdomhub.com>"

# ─── URLS ───────────────────────────────────────────────
INVITATION_BASE_URL=http://localhost:8081/activar
